    {
      "id": "b1b2c3d4-0001-4b01-8b01-000000000001",
      "name": "AUT-01 Login_Exitoso",
      "commands": [
        {
          "id": "0101",
          "comment": "Abrir la pagina de acceso",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "0102",
          "comment": "Usuario",
          "command": "executeScript",
          "target": "document.getElementById(\"usuario\").value = \"admin\";",
          "targets": [],
          "value": ""
        },
        {
          "id": "0103",
          "comment": "Clave",
          "command": "executeScript",
          "target": "document.getElementById(\"clave\").value = \"Admin123\";",
          "targets": [],
          "value": ""
        },
        {
          "id": "0104",
          "comment": "Entrar",
          "command": "click",
          "target": "id=btn-login",
          "targets": [
            [
              "id=btn-login",
              "id"
            ]
          ],
          "value": ""
        },
        {
          "id": "0105",
          "comment": "Asercion: el panel esta visible",
          "command": "assertElementPresent",
          "target": "id=dashboard",
          "targets": [
            [
              "id=dashboard",
              "id"
            ]
          ],
          "value": ""
        }
      ]
    },
